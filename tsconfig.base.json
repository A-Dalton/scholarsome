{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "strict": false,
    "target": "ES2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@scholarsome/shared": ["./libs/shared/src/index.ts"],
      "@scholarsome/prisma": ["./libs/shared/generated/prisma/browser.ts"],
      "@scholarsome/prisma/server": ["./libs/shared/generated/prisma/client.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
