{
  "name": "front",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/front/src",
  "prefix": "scholarsome",
  "tags": ["scope:client"],
  "targets": {
    "build": {
      "executor": "@ngx-env/builder:application",
      "builder": "@ngx-env/builder:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/front",
        "index": "apps/front/src/index.html",
        "browser": "apps/front/src/main.ts",
        "polyfills": ["apps/front/src/polyfills.ts"],
        "tsConfig": "apps/front/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/front/src/favicon.ico",
          "apps/front/src/assets",
          "apps/front/src/robots.txt"
        ],
        "styles": ["apps/front/src/styles.scss"],
        "scripts": [],
        "ngxEnv": {
          "prefix": "SCHOLARSOME_",
          "define": "import.meta.env"
        },
        "allowedCommonJsDependencies": ["@prisma/client", "validator"]
      },
      "configurations": {
        "production": {
          "optimization": {
            "scripts": true,
            "fonts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            }
          },
          "sourceMap": false,
          "extractLicenses": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "executor": "@ngx-env/builder:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "front:build:development",
        "proxyConfig": "apps/front/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "front:build:production"
        },
        "development": {
          "buildTarget": "front:build:development"
        }
      }
    },
    "extract-i18n": {
      "executor": "@ngx-env/builder:extract-i18n",
      "options": {
        "browserTarget": "front:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/front"],
      "options": {
        "jestConfig": "apps/front/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
